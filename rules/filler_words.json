{
  "_版本": "2.10",
  "_说明": "五类填充词 + 七组删留判别。groups 里的词可直接删；guards 里的词要看上下文，多数只出「建议改写」不动原文。宁可少删，不可误删。 standalone_only：会组成常用词的单字语气词（如「额」→金额/额度/余额），只在独立出现时才删。",
  "process_order": [
    "组合填充",
    "口头冗余",
    "句尾确认",
    "语气词",
    "句首填充"
  ],
  "groups": {
    "组合填充": {
      "mode": "phrase_first",
      "desc": "整体删除。必须最先处理，否则会被拆成单个词删碎。",
      "words": [
        "这个就是说呢",
        "这个就是说",
        "那个就是说",
        "那么就是说",
        "然后的话",
        "然后呢就是说",
        "然后呢就是",
        "这个呢就是",
        "那什么呢就是",
        "就是说来",
        "就是说呢",
        "这个那个",
        "那个这个",
        "这个这个",
        "那个那个",
        "这样的话呢",
        "这个那个的",
        "那个这个的"
      ],
      "tail_only": []
    },
    "口头冗余": {
      "mode": "phrase",
      "desc": "整体删除；加 punct_only 的几个要求后接标点或位于句末才删（「你看那边」不能删成「那边」）。「所以说」前文有因果时保留并建议改「因此」；「这样的话」后接就/才/那属条件句要保留。",
      "words": [
        "怎么说呢",
        "那个啥",
        "那个什么",
        "这个什么",
        "这样的话",
        "所以说",
        "怎么说好呢",
        "你懂我意思吧",
        "我这么说吧",
        "这么讲吧",
        "这么着吧",
        "然后呢",
        "这个样子",
        "那个样子",
        "这个样子的",
        "那样子",
        "你知道吗",
        "你懂吗",
        "你看啊",
        "你看",
        "我跟你讲",
        "我跟你说",
        "我跟您说",
        "说实话",
        "说句实话",
        "老实说",
        "坦白讲",
        "讲真",
        "说实在的",
        "你说是不是",
        "你说对吧",
        "你说呢",
        "咱这么说",
        "咱们这么说",
        "好嘛"
      ],
      "conditional": {
        "所以说": {
          "keep_if_before": [
            "因为",
            "由于",
            "导致",
            "造成",
            "之所以",
            "原因是"
          ],
          "lookback": 24,
          "when_keep": "保留，建议改「因此」"
        },
        "这样的话": {
          "keep_if_after": [
            "就",
            "才",
            "那",
            "可以",
            "才行"
          ],
          "lookahead": 3,
          "when_keep": "条件句，保留"
        }
      },
      "punct_only": [
        "你看",
        "你看啊",
        "好嘛",
        "你说呢",
        "你说对吧",
        "你说是不是",
        "你懂我意思吧"
      ],
      "_说明_连词": "「但是呢/不过呢/其实呢」不在此列：只删「呢」保留连词，否者转折关系会丢。",
      "tail_only": []
    },
    "语气词": {
      "mode": "always",
      "desc": "全部删除（mode=always）。【用户硬命令 2026-11-09】「我们」「咱们」必须留在本组无条件删除，永不允许改为语境判别、保留或仅建议改写；后续任何审计、优化、重构都不得挪动这两条，也不得据此修改相关测试预期。语气助词（嘛/哈/呢/啦/呗/哇/哟）只在句尾删，避免误伤「干嘛」「哈哈」「你呢」。",
      "words": [
        "呃",
        "额",
        "嗯",
        "唔",
        "嘶",
        "唉",
        "哦",
        "喔",
        "咦",
        "噢",
        "啊",
        "呀",
        "诶",
        "哎",
        "嘿",
        "嗯哼",
        "哎呀",
        "哎哟",
        "啊哈",
        "哦哟",
        "然后",
        "我们",
        "咱们"
      ],
      "tail_only": [
        "嘛",
        "哈",
        "嘞",
        "咧",
        "啦",
        "呗",
        "哇",
        "哟",
        "呢",
        "吧"
      ],
      "standalone_only": [
        "额"
      ],
      "tail_unless_prev": [
        "干",
        "做",
        "为",
        "打",
        "嘻",
        "喇",
        "哈",
        "密",
        "尔",
        "佛",
        "什",
        "你",
        "我",
        "他",
        "她",
        "它",
        "您",
        "咱",
        "酒",
        "网",
        "氧",
        "咖",
        "贴",
        "王"
      ]
    },
    "句首填充": {
      "mode": "sentence_start",
      "desc": "仅在句首或停顿后删除。后接名词性成分（有指示对象）时保留。",
      "words": [
        "这个",
        "那个",
        "就是说",
        "那么",
        "那什么",
        "那么说",
        "这一块",
        "这一部分",
        "这一方面",
        "好"
      ],
      "referential": [
        "这个",
        "那个"
      ],
      "noun_pos": [
        "n",
        "nz",
        "nr",
        "ns",
        "nt",
        "nw",
        "vn",
        "f",
        "q",
        "mq",
        "s"
      ],
      "referential_keep_examples": [
        "这个文件",
        "那个条款",
        "这个批号",
        "那个规定"
      ],
      "loose_referential": [
        "这个",
        "那个"
      ],
      "loose_desc": "「这个/那个」后接逗号顿号时，不论在句中还是句首一律删——后接标点说明它没有修饰对象。",
      "bare": [
        "就是说"
      ],
      "bare_desc": "这类词没有实词用法，句首或停顿后直接删，不要求后接标点。",
      "tail_only": []
    },
    "句尾确认": {
      "mode": "sentence_end",
      "desc": "仅在句尾删除，删后若句尾无标点则补句号。只收「删掉主句仍完整」的附加确认词——「懂吗 / 可以吗 / 听明白了吗」这类是实义问句，删了句子会断，不收。",
      "words": [
        "对吧",
        "是吧",
        "是不是",
        "好不好",
        "行不行",
        "对不对",
        "对吧啊",
        "对不对啊",
        "是这么回事吧"
      ],
      "tail_only": []
    }
  },
  "guards": {
    "自称": {
      "words": [
        "我们",
        "咱们"
      ],
      "official_cues": [
        "监管",
        "要求",
        "局",
        "单位",
        "部门",
        "规定",
        "职责",
        "检查",
        "执法",
        "备案",
        "审批",
        "许可",
        "处罚",
        "标准",
        "流程",
        "制度",
        "本局",
        "本单位"
      ],
      "lead_cues": [
        "来看",
        "来看一下",
        "看一个",
        "看下",
        "先看",
        "讲一下",
        "说一下",
        "讲一讲"
      ],
      "rewrite": {
        "我们": "我局",
        "咱们": "本单位"
      },
      "lookahead": 12,
      "desc": "【已停用，用户硬命令 2026-11-09】「我们/咱们」由语气词组无条件删除，本 guard 不会再命中；保留配置只为兼容旧词表，不得据此把两个词移回语境判别。"
    },
    "指代": {
      "words": [
        "这个",
        "那个"
      ],
      "noun_pos": [
        "n",
        "nz",
        "nr",
        "ns",
        "nt",
        "nw",
        "vn",
        "f",
        "q",
        "mq",
        "s"
      ],
      "desc": "后接名词性成分时保留（这个文件、那个条款）。"
    },
    "转折": {
      "words": [
        "实际上",
        "其实",
        "事实上"
      ],
      "keep_cues": [
        "是",
        "但是",
        "而是",
        "并非",
        "恰恰",
        "相反",
        "却",
        "不",
        "更",
        "反而"
      ],
      "desc": "表转折强调时保留（其实是这样 / 其实不然）；后接标点或充当口头禅时删。"
    },
    "约量": {
      "words": [
        "基本上",
        "大概",
        "差不多",
        "大致",
        "大约",
        "差不多是"
      ],
      "data_re": [
        "\\d",
        "第[一二三四五六七八九十百千]+条",
        "百分之",
        "[一二三四五六七八九十百千万]+(?:元|倍|天|日|个月|年|个工作日|公里|千克|克|毫克)"
      ],
      "lookahead": 10,
      "desc": "后跟数字、法条、金额时保留并回听核对——正式稿不能含糊；否则当无信息填充删掉。"
    },
    "解释": {
      "words": [
        "应该讲",
        "可以说",
        "换句话说",
        "也就是说",
        "也就是说呢",
        "换句话讲"
      ],
      "filler_next": [
        "是",
        "非常",
        "很",
        "相当",
        "基本",
        "完全",
        "都",
        "也",
        "还"
      ],
      "min_tail": 6,
      "rewrite_to": "即",
      "desc": "当填充语时删；确有解释功能时建议精简为「即」（只建议，不自动改）。"
    },
    "引导": {
      "words": [
        "大家可以看到",
        "我们可以看到",
        "请注意",
        "大家注意",
        "可以看到",
        "咱们看"
      ],
      "rewrite": {
        "大家可以看到": "参见",
        "我们可以看到": "参见",
        "可以看到": "参见",
        "请注意": "注意",
        "大家注意": "注意",
        "咱们看": "下面看"
      },
      "repeat_limit": 2,
      "desc": "课件引导句保留并精简为「注意/参见」；同一篇里超过 repeat_limit 次的部分删。"
    }
  },
  "repeat_merge": {
    "enabled": true,
    "single_char_dupes": [
      "我",
      "你",
      "他",
      "她",
      "它",
      "您",
      "咱"
    ],
    "words": [
      "我们",
      "咱们",
      "大家",
      "就是",
      "那个",
      "这个",
      "然后",
      "其实",
      "所以说"
    ],
    "min_unit_len": 2,
    "max_unit_len": 4,
    "max_rounds": 3
  },
  "protect_patterns": [
    "\\d+",
    "第[一二三四五六七八九十百千]+条",
    "不得",
    "禁止",
    "严禁",
    "必须",
    "应当",
    "不予",
    "撤销",
    "吊销",
    "没收",
    "罚款",
    "构成犯罪"
  ],
  "warn_shrink_ratio": 0.5,
  "_处理顺序说明": "组合填充 → 口头冗余 → 句尾确认 → 语气词 → 句首填充。长短语优先，单字最后：否则「对吧」会被「吧」拆成「对」。"
}